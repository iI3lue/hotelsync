# Front (Next.js). Copiar a .env.local para desarrollo; las URLs de servicios
# caen a localhost por defecto, asi que el minimo necesario es el simulador OTA.
CHANNEL_MANAGER_API_URL=http://localhost:3008/v1
# Debe coincidir con CHANNEL_MANAGER_SIMULATOR_KEY del channel-manager
# (el seed guarda sha256 de esta clave en Channel.provider_key_hash).
CHANNEL_MANAGER_SIMULATOR_KEY=replace-with-the-same-value-as-channel-manager

# Opcionales en local (defaults: localhost:3001-3011):
# NEXT_PUBLIC_PROPERTY_API_URL=http://localhost:3001/v1
# NEXT_PUBLIC_RATE_API_URL=http://localhost:3002/v1
# NEXT_PUBLIC_USER_API_URL=http://localhost:3003/v1
# NEXT_PUBLIC_BOOKING_API_URL=http://localhost:3004/v1
# NEXT_PUBLIC_FRONT_DESK_API_URL=http://localhost:3005/v1
# NEXT_PUBLIC_HOUSEKEEPING_API_URL=http://localhost:3006/v1
# NEXT_PUBLIC_BILLING_API_URL=http://localhost:3007/v1
# NEXT_PUBLIC_LOYALTY_API_URL=http://localhost:3009/v1
# NEXT_PUBLIC_PAYMENT_API_URL=http://localhost:3010/v1
# NEXT_PUBLIC_ANALYTICS_API_URL=http://localhost:3011/v1

# Gateway interno (opcional; vacio = llamadas directas a cada servicio):
# GATEWAY_URL=http://localhost:8080
# GATEWAY_SHARED_SECRET=replace-with-the-same-value-as-api-gateway
# GATEWAY_SERVICES=property,rate-availability,user,booking,front-desk,housekeeping,billing,loyalty,payment,analytics,channel-manager

# Auth0 (solo si se prueba login social en local):
# AUTH0_DOMAIN=
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# APP_BASE_URL=http://localhost:3000
