NODE_ENV=development
PORT=3009
# Cambiar a 3010 al integrar al monorepo (puerto reservado para payment).
# PORT=3010
DATABASE_URL=postgresql://hotelsync:payment_dev@localhost:5441/payment_db
# OBLIGATORIO: idéntico al AUTH_JWT_SECRET de user-service. Un valor distinto
# rompe la verificación del Bearer con 401 (verificado en loyalty 2026-10-14).
AUTH_JWT_SECRET=change-me-to-user-service-secret-min-32-chars
BOOKING_SERVICE_URL=http://localhost:3004/v1
BOOKING_SERVICE_KEY=change-me-to-booking-service-key
RABBITMQ_URL=amqp://localhost:5672
