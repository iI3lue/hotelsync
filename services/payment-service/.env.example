NODE_ENV=development
# 3009 es loyalty-service: payment usa 3010.
PORT=3010
DATABASE_URL=postgresql://hotelsync:payment_dev@localhost:5441/payment_db
# OBLIGATORIO: idéntico al AUTH_JWT_SECRET de user-service (min 32 chars).
# Un valor distinto rompe la verificación del Bearer con 401 (verificado en loyalty 2026-10-14).
AUTH_JWT_SECRET=change-me-to-user-service-secret-min-32-chars
BOOKING_SERVICE_URL=http://localhost:3004/v1
# Se envía como header x-payment-key. Debe coincidir con PAYMENT_SERVICE_KEY de booking-service.
BOOKING_SERVICE_KEY=change-me-to-booking-service-payment-key
# Moneda de los cobros (las reservas no guardan moneda).
PAYMENT_CURRENCY=COP
# Sin RABBITMQ_URL el cobro funciona y el outbox queda `pending` hasta que haya broker.
RABBITMQ_URL=amqp://localhost:5672

# --- Gateway: verificación de x-gateway-secret (ver ROLLOUT-GATEWAY.md) ---
# Secreto compartido entre gateway/BFF y los 11 servicios. Vacío = verificación apagada.
GATEWAY_SECRET=
# Solo durante una rotación: el secreto anterior que aún se acepta.
GATEWAY_SECRET_PREVIOUS=
# warn (por defecto): solo registra; enforce: responde 401 si falta el secreto.
GATEWAY_MODE=warn

# --- Observabilidad: token para exigir /metrics (vacio = 404 en Render) ---
METRICS_TOKEN=
