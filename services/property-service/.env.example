# Property Service — copiar a .env y completar
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://hotelsync:hotelsync_dev@localhost:5432/property_db?schema=public
RABBITMQ_URL=amqp://localhost:5672
# Debe ser idéntico al AUTH_JWT_SECRET de user-service.
AUTH_JWT_SECRET=hotelsync-dev-secret-change-me-min-32-chars-ok

# --- Gateway: verificación de x-gateway-secret (ver ROLLOUT-GATEWAY.md) ---
# Secreto compartido entre gateway/BFF y los 11 servicios. Vacío = verificación apagada.
GATEWAY_SECRET=
# Solo durante una rotación: el secreto anterior que aún se acepta.
GATEWAY_SECRET_PREVIOUS=
# warn (por defecto): solo registra; enforce: responde 401 si falta el secreto.
GATEWAY_MODE=warn
