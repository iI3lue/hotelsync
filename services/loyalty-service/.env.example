NODE_ENV=development
PORT=3009
DATABASE_URL=postgresql://hotelsync:loyalty_dev@localhost:5440/loyalty_db
AUTH_JWT_SECRET=super_secret_jwt_key_for_hotelsync_dev
BOOKING_SERVICE_URL=http://localhost:3004/v1
USER_SERVICE_URL=http://localhost:3003/v1
RABBITMQ_URL=amqp://localhost:5672
# Clave propia para leer reservas (header x-loyalty-key) y estado de cuentas (header x-loyalty-key).
# Debe coincidir con LOYALTY_SERVICE_KEY de booking-service y user-service.
LOYALTY_SERVICE_KEY=replace-with-random-32-plus-character-secret

# --- Gateway: verificación de x-gateway-secret (ver ROLLOUT-GATEWAY.md) ---
# Secreto compartido entre gateway/BFF y los 11 servicios. Vacío = verificación apagada.
GATEWAY_SECRET=
# Solo durante una rotación: el secreto anterior que aún se acepta.
GATEWAY_SECRET_PREVIOUS=
# warn (por defecto): solo registra; enforce: responde 401 si falta el secreto.
GATEWAY_MODE=warn

# --- Observabilidad: token para exigir /metrics (vacio = 404 en Render) ---
METRICS_TOKEN=
