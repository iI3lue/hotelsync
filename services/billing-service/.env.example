# Billing Service — copiar a .env y completar
NODE_ENV=development
PORT=3007
DATABASE_URL=postgresql://hotelsync:hotelsync_dev@localhost:5437/billing_db
BOOKING_SERVICE_URL=http://localhost:3004/v1
# Debe coincidir con BILLING_SERVICE_KEY de Booking (header x-billing-key).
BOOKING_SERVICE_KEY=hotelsync-dev-billing-key-change-me
PROPERTY_SERVICE_URL=http://localhost:3001/v1
# Debe ser idéntico al AUTH_JWT_SECRET de user-service.
AUTH_JWT_SECRET=hotelsync-dev-secret-change-me-min-32-chars-ok
RABBITMQ_URL=amqp://localhost:5672
DEFAULT_CURRENCY=COP

# --- Gateway: verificación de x-gateway-secret (ver ROLLOUT-GATEWAY.md) ---
# Secreto compartido entre gateway/BFF y los 11 servicios. Vacío = verificación apagada.
GATEWAY_SECRET=
# Solo durante una rotación: el secreto anterior que aún se acepta.
GATEWAY_SECRET_PREVIOUS=
# warn (por defecto): solo registra; enforce: responde 401 si falta el secreto.
GATEWAY_MODE=warn

# --- Observabilidad: token para exigir /metrics (vacio = 404 en Render) ---
METRICS_TOKEN=
