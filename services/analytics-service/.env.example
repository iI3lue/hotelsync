NODE_ENV=development
PORT=3011
DATABASE_URL=postgresql://hotelsync:analytics_dev@localhost:5442/analytics_db
# Réplicas de SOLO LECTURA (usuarios read-only en producción).
DATABASE_URL_BOOKING=postgresql://hotelsync:booking_dev@localhost:5434/booking_db
DATABASE_URL_PROPERTY=postgresql://hotelsync:property_dev@localhost:5432/property_db
# OBLIGATORIO: idéntico al AUTH_JWT_SECRET de user-service.
AUTH_JWT_SECRET=change-me-to-user-service-secret-min-32-chars
RABBITMQ_URL=amqp://localhost:5672
# Corrida programada del ETL. Sin datos: cada 6 h, arranca a los 30 s, ventana de 7 días.
# ETL_INTERVAL_MS=21600000
# ETL_START_DELAY_MS=30000
# ETL_LOOKBACK_DAYS=7

# --- Gateway: verificación de x-gateway-secret (ver ROLLOUT-GATEWAY.md) ---
# Secreto compartido entre gateway/BFF y los 11 servicios. Vacío = verificación apagada.
GATEWAY_SECRET=
# Solo durante una rotación: el secreto anterior que aún se acepta.
GATEWAY_SECRET_PREVIOUS=
# warn (por defecto): solo registra; enforce: responde 401 si falta el secreto.
GATEWAY_MODE=warn
