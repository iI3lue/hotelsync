# Rate & Availability Service — copiar a .env y completar
NODE_ENV=development
PORT=3002
DATABASE_URL=postgresql://hotelsync:hotelsync_dev@localhost:5433/rate_availability_db?schema=public
# Redis para cache-aside. Vacio = cache deshabilitada, opera igual.
REDIS_URL=redis://localhost:6379
RATE_CACHE_AVAIL_TTL=60
RATE_CACHE_RATES_TTL=300
# Debe ser idéntico al AUTH_JWT_SECRET de user-service.
AUTH_JWT_SECRET=hotelsync-dev-secret-change-me-min-32-chars-ok
# Clave interna Booking -> R&A (header x-service-key).
SERVICE_API_KEY=hotelsync-dev-service-key-change-me
PROPERTY_SERVICE_URL=http://localhost:3001/v1
RABBITMQ_URL=amqp://localhost:5672
