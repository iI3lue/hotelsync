# User Service — copiar a .env y completar
NODE_ENV=development
PORT=3003
DATABASE_URL=postgresql://hotelsync:hotelsync_dev@localhost:5438/user_db?schema=public
# HS256 compartido por todos los servicios (minimo 32 caracteres).
AUTH_JWT_SECRET=hotelsync-dev-secret-change-me-min-32-chars-ok

# Auth0: login federado con Google (el front envia el id_token).
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=

# Recuperacion de contrasena.
PASSWORD_RESET_BASE_URL=http://localhost:3000/cuenta/restablecer
# log = no hay envio real (desarrollo); smtp = envio real.
MAILER_PROVIDER=log
# Solo desarrollo/demo: expone el codigo y el enlace de reset.
PASSWORD_RESET_DEMO_CODE=true

# booking-service: verifica reservas activas antes de borrar una cuenta.
BOOKING_SERVICE_URL=http://localhost:3004/v1
BOOKING_SERVICE_KEY=hotelsync-dev-user-key-change-me

# Clave interna que valida loyalty-service al consultar usuarios (x-loyalty-key).
LOYALTY_SERVICE_KEY=hotelsync-dev-loyalty-key-change-me

# Solo para el seed: crea el primer SUPER_ADMIN si ambos valores existen.
BOOTSTRAP_ADMIN_EMAIL=admin@hotelsync.local
BOOTSTRAP_ADMIN_PASSWORD=Admin123!
