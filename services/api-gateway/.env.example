# Puerto del gateway. En docker-compose: 8080 (Adminer queda en 8082).
NODE_ENV=development
PORT=8080
UPSTREAM_TIMEOUT_MS=45000
GATEWAY_SHARED_SECRET=replace-with-a-random-32-plus-character-secret
# El gateway reenvia este valor a los servicios como `x-gateway-secret`. Debe ser
# el mismo que `GATEWAY_SECRET` en los 11 servicios (ver ROLLOUT-GATEWAY.md).

# Despertar servicios free dormidos: primer request autenticado = ping a todos.
WAKE_ALL_ENABLED=true
WAKE_ALL_INTERVAL_MS=1800000
WAKE_ALL_TIMEOUT_MS=60000

PROPERTY_SERVICE_URL=http://localhost:3001/v1
RATE_AVAILABILITY_SERVICE_URL=http://localhost:3002/v1
USER_SERVICE_URL=http://localhost:3003/v1
BOOKING_SERVICE_URL=http://localhost:3004/v1
FRONT_DESK_SERVICE_URL=http://localhost:3005/v1
HOUSEKEEPING_SERVICE_URL=http://localhost:3006/v1
BILLING_SERVICE_URL=http://localhost:3007/v1
LOYALTY_SERVICE_URL=http://localhost:3009/v1
PAYMENTS_SERVICE_URL=http://localhost:3010/v1
ANALYTICS_SERVICE_URL=http://localhost:3011/v1
CHANNEL_MANAGER_SERVICE_URL=http://localhost:3008/v1/simulator
