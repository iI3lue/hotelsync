{
  "name": "hotelsync",
  "version": "1.0.0",
  "private": true,
  "description": "HotelSync — multi-property hotel management platform",
  "workspaces": [
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "dev:property": "npm run dev --workspace=services/property-service",
    "dev:rate": "npm run dev --workspace=services/rate-availability-service",
    "dev:booking": "npm run dev --workspace=services/booking-service",
    "dev:front-desk": "npm run dev --workspace=services/front-desk-service",
    "dev:housekeeping": "npm run dev --workspace=services/housekeeping-service",
    "dev:billing": "npm run dev --workspace=services/billing-service",
    "dev:front": "npm run dev --workspace=apps/front",
    "dev:user": "npm run dev --workspace=services/user-service",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "migrate:property": "npm exec --workspace=services/property-service -- prisma migrate dev",
    "migrate:rate": "npm exec --workspace=services/rate-availability-service -- prisma migrate dev",
    "migrate:booking": "npm exec --workspace=services/booking-service -- prisma migrate dev",
    "migrate:front-desk": "npm exec --workspace=services/front-desk-service -- prisma migrate dev",
    "migrate:housekeeping": "npm exec --workspace=services/housekeeping-service -- prisma migrate dev",
    "migrate:billing": "npm exec --workspace=services/billing-service -- prisma migrate dev",
    "migrate:user": "npm exec --workspace=services/user-service -- prisma migrate dev",
    "seed:property": "npm run seed --workspace=services/property-service",
    "seed:rate": "npm run seed --workspace=services/rate-availability-service",
    "seed:booking": "npm run seed --workspace=services/booking-service",
    "seed:front-desk": "npm run seed --workspace=services/front-desk-service",
    "seed:housekeeping": "npm run seed --workspace=services/housekeeping-service",
    "seed:billing": "npm run seed --workspace=services/billing-service",
    "seed:user": "npm run seed --workspace=services/user-service"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
